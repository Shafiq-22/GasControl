# Optional. The store's own Supabase project is built in as the default
# (src/lib/supabase/config.ts), so the app runs without any of this. Set these
# only to point a deployment at a different project.
#
# Both values are publishable: the key is designed to ship in the browser and
# grants nothing on its own. Row level security is the boundary, and a new
# signup can read nothing until an administrator approves it.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Optional. Only needed by scripts that bypass RLS (bulk import as a service role).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
